# ---------------------------------------------------------------------------
# AI provider (optional — the app works without it, AI features just turn off)
# No key is included with the public repo. Add your own provider key here or
# leave AI_API_KEY blank to keep AI features disabled.
# ---------------------------------------------------------------------------
# One of: google (default) | openai | anthropic
AI_PROVIDER=google
# Your provider API key for your own deployment. Legacy GEMINI_API_KEY / OPENAI_API_KEY /
# ANTHROPIC_API_KEY are also accepted.
AI_API_KEY=
# Override the model. Defaults: google=gemini-2.5-flash,
# openai=gpt-4o-mini, anthropic=claude-3-5-haiku-latest
AI_MODEL=
AI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Local dev API server
# ---------------------------------------------------------------------------
API_PORT=8787
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_LAN_IP:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Redis storage (required for persistent /api/books on Vercel)
# Vercel's Upstash integration injects these for you. A store connected
# straight from Upstash uses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# instead; either pair works.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
BOOKS_KV_KEY=reading-app:books

# ---------------------------------------------------------------------------
# App access (required on Vercel; optional for local development)
# ---------------------------------------------------------------------------
# Protects your book list and optional AI endpoints with a simple shared
# password. Generate with: openssl rand -base64 24
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Cron + admin secrets (generate with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Shared secret Vercel Cron sends as an Authorization header
CRON_SECRET=
ADMIN_TEST_SECRET=

# ---------------------------------------------------------------------------
# Web Push (generate with: npx web-push generate-vapid-keys)
# ---------------------------------------------------------------------------
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
PUSH_SUBSCRIPTIONS_KV_KEY=reading-app:push-subscriptions
READING_REMINDER_META_KEY=reading-app:reminder-meta
